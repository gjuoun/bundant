---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { docRank, docTitle } from '@/lib/docs';
import { withBase } from '@/lib/utils';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const current = entry.id;

const docs = (await getCollection('docs')).sort((a, b) => docRank(a.id) - docRank(b.id));
const title = docTitle(current);
---

<Base title={`${title} — bundant docs`} description={`bundant documentation: ${title}.`}>
  <Nav />
  <main class="container-page grid gap-10 py-10 md:py-14 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-14">
    <aside class="min-w-0 lg:sticky lg:top-24 lg:self-start">
      <p class="mono-label">Documentation</p>
      <nav class="mt-3 flex flex-wrap gap-1 lg:flex-col lg:gap-0.5" aria-label="Docs">
        <a
          href={withBase('docs/')}
          class="flex min-h-11 items-center rounded-md px-3 text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground lg:min-h-9"
        >
          Overview
        </a>
        {docs.map((doc) => (
          <a
            href={withBase(`docs/${doc.id}/`)}
            aria-current={doc.id === current ? 'page' : undefined}
            class:list={[
              'flex min-h-11 items-center rounded-md px-3 text-sm transition-colors lg:min-h-9',
              doc.id === current
                ? 'bg-accent/50 font-medium text-accent-foreground'
                : 'text-muted-foreground hover:bg-muted hover:text-foreground',
            ]}
          >
            {docTitle(doc.id)}
          </a>
        ))}
      </nav>
    </aside>

    <article class="docs-prose min-w-0 max-w-3xl">
      <Content />
      <div class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-5 text-sm">
        <a href={withBase('docs/')} class="inline-flex min-h-11 items-center text-muted-foreground hover:text-foreground sm:min-h-0">
          ← All docs
        </a>
        <a
          href={`https://github.com/gjuoun/bundant/blob/main/docs/${current}.md`}
          class="inline-flex min-h-11 items-center text-muted-foreground hover:text-foreground sm:min-h-0"
        >
          Edit on GitHub
        </a>
      </div>
    </article>
  </main>
  <Footer />
</Base>
