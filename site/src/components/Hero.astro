---
import { ArrowRight, Check } from 'lucide-react';
import { buttonVariants } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { CopyCommand } from '@/components/CopyCommand';
import TerminalDemo from '@/components/TerminalDemo';
import demo from '@/data/demo.json';
import { installCommands } from '@/lib/features';
import { withBase } from '@/lib/utils';
---

<section class="border-b border-border">
  <div class="container-page grid gap-10 py-14 md:grid-cols-[1.05fr_0.95fr] md:items-start md:gap-10 md:py-20 lg:gap-16 lg:py-24">
    <div class="min-w-0 md:col-start-1 md:row-start-1">
      <Badge variant="accent" className="rounded-md px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider">
        v0.1.0 · MIT
      </Badge>

      <h1 class="mt-5 text-[2.35rem] font-semibold leading-[1.06] tracking-[-0.04em] sm:text-5xl md:text-[2.55rem] lg:text-[3.6rem]">
        Ship to the box
        <span class="block">you already own.</span>
      </h1>

      <p class="mt-5 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg">
        bundant ships your container over plain SSH, gates it on health, and swaps traffic
        through kamal-proxy. Docker or podman, one CLI, nothing left running on the host.
        <span class="text-foreground">No Kubernetes. <span class="whitespace-nowrap">No registry required.</span></span>
      </p>

      <div class="mt-7 grid gap-2.5 sm:flex sm:flex-wrap sm:items-center">
        <a href={withBase('docs/')} class={buttonVariants({ size: 'lg', className: 'w-full sm:w-auto' })}>
          Get started
          <ArrowRight className="size-4" />
        </a>
        <a href={withBase('#commands')} class={buttonVariants({ size: 'lg', variant: 'outline', className: 'w-full sm:w-auto' })}>
          Browse commands
        </a>
      </div>
    </div>

    <div class="min-w-0 md:col-start-2 md:row-span-2 md:row-start-1 lg:pt-1">
      <p class="mono-label mb-3">Try a command · recorded run</p>
      <TerminalDemo demo={demo} client:load layout="compact" />
    </div>

    <div class="min-w-0 md:col-start-1 md:row-start-2">
      <div class="max-w-md">
        <CopyCommand commands={installCommands} client:load />
      </div>

      <ul class="mt-6 flex flex-col gap-2 text-[0.8125rem] text-muted-foreground sm:flex-row sm:flex-wrap sm:gap-x-5">
        <li class="flex items-center gap-1.5"><Check className="size-3.5 text-primary" /> docker or podman</li>
        <li class="flex items-center gap-1.5"><Check className="size-3.5 text-primary" /> plain ssh, no agent</li>
        <li class="flex items-center gap-1.5"><Check className="size-3.5 text-primary" /> MIT, self-hosted</li>
      </ul>
    </div>
  </div>
</section>
