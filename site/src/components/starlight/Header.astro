---
import Search from '@astrojs/starlight/components/Search.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const links = [
  { href: base + '/#features', label: 'Features' },
  { href: base + '/#how', label: 'How it works' },
  { href: base + '/#commands', label: 'Commands' },
  { href: base + '/docs/', label: 'Docs' },
];
---

<div class="bf-header">
  <div class="bf-bar">
    <a href={base + '/'} class="bf-brand" aria-label="bundant home">
      <span class="bf-mark">b</span>
      <span class="bf-name">bundant</span>
      <span class="bf-version">0.1.0</span>
    </a>

    <nav class="bf-nav" aria-label="Primary">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="bf-actions">
      <div class="bf-search"><Search /></div>
      <a
        href="https://github.com/gjuoun/bundant"
        target="_blank"
        rel="noreferrer"
        class="bf-github"
        aria-label="bundant on GitHub"
      >
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
        <span>GitHub</span>
      </a>
    </div>
  </div>
</div>

<style>
  .bf-header {
    height: 100%;
  }

  .bf-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  .bf-brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    text-decoration: none;
    color: #d9d9d4;
  }

  .bf-mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.375rem;
    background: #40c4ff;
    color: #1f231f;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .bf-name {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #d9d9d4;
  }

  .bf-version {
    display: none;
    border: 1px solid #494848;
    border-radius: 0.25rem;
    padding: 0.125rem 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: #9c9a8f;
  }

  .bf-nav {
    display: none;
    align-items: center;
    gap: 0.25rem;
    margin-inline-start: 0.5rem;
  }

  .bf-nav a {
    display: inline-flex;
    align-items: center;
    height: 2.75rem;
    padding-inline: 0.75rem;
    white-space: nowrap;
    border-radius: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #9c9a8f;
    text-decoration: none;
  }

  .bf-nav a:hover {
    background: #2e332e;
    color: #d9d9d4;
  }

  .bf-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-start: auto;
    min-width: 0;
  }

  .bf-search {
    display: flex;
    min-width: 0;
  }

  .bf-search :global(site-search) {
    display: contents;
  }

  .bf-search :global(button[data-open-modal]) {
    height: 2.5rem;
  }

  .bf-github {
    display: none;
    align-items: center;
    gap: 0.5rem;
    height: 2.75rem;
    padding-inline: 0.75rem;
    border: 1px solid #494848;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #9c9a8f;
    text-decoration: none;
  }

  .bf-github:hover {
    background: #2e332e;
    color: #d9d9d4;
  }

  @media (min-width: 40rem) {
    .bf-version {
      display: inline;
    }

    .bf-github {
      display: inline-flex;
    }
  }

  @media (min-width: 50rem) {
    .bf-bar {
      padding-inline: 2rem;
    }

    .bf-nav {
      display: flex;
    }

    .bf-search :global(button[data-open-modal]) {
      width: 9rem;
    }

    .bf-actions {
      flex-shrink: 0;
    }
  }

  @media (min-width: 72rem) {
    .bf-search :global(button[data-open-modal]) {
      width: 13rem;
    }
  }
</style>
