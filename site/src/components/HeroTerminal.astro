---
import { ArrowRight, Check, FileCode, GitBranch } from 'lucide-react';
---

<div class="overflow-hidden rounded-xl border border-border bg-card">
  <div class="flex items-center justify-between gap-3 border-b border-border-muted bg-code-surface px-4 py-2.5">
    <div class="flex items-center gap-2 font-mono text-[11px] text-muted-foreground">
      <FileCode className="size-3.5" />
      deploy.yml
    </div>
    <span class="rounded border border-border px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
      the contract
    </span>
  </div>

  <pre class="overflow-x-auto border-b border-border-muted bg-code-surface px-4 py-4 font-mono text-[11.5px] leading-6 text-foreground"><code><span class="text-code-key">service</span>: <span class="text-code-string">hello</span>
<span class="text-code-key">image</span>: <span class="text-code-string">traefik/whoami:v1.10</span>
<span class="text-code-key">hosts</span>: [<span class="text-code-string">root@box.example.com</span>]
<span class="text-code-key">healthcheck</span>:
  <span class="text-code-key">path</span>: <span class="text-code-string">/</span>
<span class="text-code-key">proxy</span>:
  <span class="text-code-key">host</span>: <span class="text-code-string">hello.example.com</span></code></pre>

  <div class="space-y-3 px-4 py-4">
    <div class="flex items-center gap-2 font-mono text-[11.5px]">
      <span class="text-primary">$</span>
      <span class="text-code-key">bundant</span> <span class="text-foreground">deploy -f deploy.yml</span>
    </div>
    <ul class="space-y-2.5 font-mono text-[11px]">
      <li class="flex items-start gap-2 text-muted-foreground">
        <Check className="mt-px size-3.5 shrink-0 text-success" />
        <span>revision <span class="text-foreground">hello-web-59ceb8d</span> started unpublished</span>
      </li>
      <li class="flex items-start gap-2 text-muted-foreground">
        <Check className="mt-px size-3.5 shrink-0 text-success" />
        <span>health gate passed</span>
      </li>
      <li class="flex items-start gap-2 text-muted-foreground">
        <ArrowRight className="mt-px size-3.5 shrink-0 text-arrow" />
        <span>proxy target set swapped in one call</span>
      </li>
      <li class="flex items-start gap-2 text-muted-foreground">
        <GitBranch className="mt-px size-3.5 shrink-0 text-code-type" />
        <span>old revision kept for rollback</span>
      </li>
    </ul>
  </div>
</div>
