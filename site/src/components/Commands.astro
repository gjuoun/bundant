---
import { ArrowUpRight } from 'lucide-react';
import { CommandTabs } from '@/components/CommandTabs';
import { commandGroups, commandCount } from '@/lib/commands';
import { withBase } from '@/lib/utils';
---

<section id="commands" class="border-b border-border py-16 md:py-24">
  <div class="container-page">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="mono-label">Commands</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          The whole CLI, in four groups.
        </h2>
        <p class="mt-4 text-muted-foreground">
          {commandCount} commands, one binary. Every flag below is in the
          <span class="font-mono text-foreground"> bundant --help </span>
          tree today.
        </p>
      </div>
      <a href={withBase('docs/cli/')} class="inline-flex min-h-11 items-center gap-1.5 text-sm font-medium text-accent-foreground hover:underline">
        Full CLI reference
        <ArrowUpRight className="size-4" />
      </a>
    </div>

    <CommandTabs groups={commandGroups} client:load />
  </div>
</section>
