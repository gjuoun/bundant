---
import { Check } from 'lucide-react';
import { dryRunExcerpt, howSteps, whyCards } from '@/lib/features';
---

<section id="why" class="border-b border-border py-16 md:py-24">
  <span id="how" class="block scroll-mt-20"></span>
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="mono-label">Why and how</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
        The platform is the overhead.
      </h2>
      <p class="mt-4 text-muted-foreground">
        A single host already gives you a network, a proxy and a restart policy. bundant adds
        the deploy discipline without asking you to run a cluster to get it.
      </p>
    </div>

    <ul class="mt-10 grid min-w-0 overflow-hidden rounded-xl border border-border bg-card sm:grid-cols-3 sm:divide-x sm:divide-border-muted">
      {whyCards.map((card, index) => (
        <li class="flex min-w-0 gap-4 border-b border-border-muted p-5 last:border-b-0 sm:border-b-0 sm:p-6">
          <span class="font-mono text-[11px] text-primary">{String(index + 1).padStart(2, '0')}</span>
          <div class="min-w-0">
            <h3 class="text-[0.9375rem] font-semibold tracking-tight">{card.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{card.body}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-12">
      <p class="mono-label">A deploy, in four steps</p>
      <ol class="mt-5 grid min-w-0 gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-0 lg:divide-x lg:divide-border-muted">
        {howSteps.map((step) => (
          <li class="min-w-0 lg:px-6 lg:first:pl-0 lg:last:pr-0">
            <div class="flex items-center gap-2.5">
              <span class="grid size-7 shrink-0 place-items-center rounded-full border border-border bg-muted font-mono text-[11px] text-primary">
                {step.step}
              </span>
              <h3 class="text-[0.9375rem] font-semibold tracking-tight">{step.title}</h3>
            </div>
            <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">{step.body}</p>
          </li>
        ))}
      </ol>

      <div class="mt-8 min-w-0 overflow-hidden rounded-xl border border-border bg-code-surface">
        <div class="flex items-center justify-between gap-3 border-b border-border-muted px-4 py-2.5">
          <div class="flex min-w-0 items-center gap-2 font-mono text-[11px] text-muted-foreground">
            <span class="size-1.5 shrink-0 rounded-full bg-code-key"></span>
            <span class="truncate">bundant deploy --dry-run</span>
          </div>
          <span class="shrink-0 rounded border border-border px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">real output</span>
        </div>
        <pre class="max-w-full overflow-x-auto whitespace-pre-wrap break-words px-4 py-4 font-mono text-[11px] leading-[1.75] text-muted-foreground"><code>{dryRunExcerpt}</code></pre>
        <div class="flex items-start gap-2 border-t border-border-muted px-4 py-3 text-[11px] leading-relaxed text-muted-foreground">
          <Check className="mt-0.5 size-3.5 shrink-0 text-success" />
          <span>Every step is printed before it runs. <span class="text-foreground">Nothing hidden, nothing implicit.</span></span>
        </div>
      </div>
    </div>
  </div>
</section>
