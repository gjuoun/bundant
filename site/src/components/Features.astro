---
import { Activity, Boxes, Container, Layers, Route, ShieldCheck, Terminal, Wand2 } from 'lucide-react';
import { features, type FeatureIcon } from '@/lib/features';

const icons: Record<FeatureIcon, typeof Boxes> = {
  boxes: Boxes,
  layers: Layers,
  route: Route,
  'shield-check': ShieldCheck,
  container: Container,
  activity: Activity,
  wand: Wand2,
  terminal: Terminal,
};
---

<section id="features" class="border-b border-border py-16 md:py-24">
  <div class="container-page">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="mono-label">Features</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          Everything the CLI does.<br class="hidden sm:block" />
          Nothing it pretends to.
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-muted-foreground md:text-right">
        Eight capabilities, all present in <span class="font-mono text-foreground">bundant 0.1.0</span>.
        If it is not in the CLI today, it is not on this page.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => {
        const Icon = icons[feature.icon];
        return (
          <article data-feature class="rounded-xl border border-border bg-card p-6">
            <span class="grid size-9 place-items-center rounded-lg border border-border bg-background text-muted-foreground">
              <Icon className="size-4" />
            </span>
            <h3 class="mt-4 text-[0.9375rem] font-semibold tracking-tight">{feature.title}</h3>
            <p class="mt-2 text-[0.8125rem] leading-relaxed text-muted-foreground">{feature.description}</p>
          </article>
        );
      })}
    </div>
  </div>
</section>
