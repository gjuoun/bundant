---
const columns = ['bundant', 'Kamal', 'Dokku', 'Coolify'];

const rows = [
  {
    attribute: 'Registry',
    values: ['Optional', 'Yes', 'No', 'No'],
    note: 'bundant can stream a local image over ssh; a registry tag is pulled normally.',
  },
  {
    attribute: 'Kubernetes',
    values: ['No', 'No', 'No', 'No'],
    note: 'None of these needs a cluster.',
  },
  {
    attribute: 'Stateful',
    values: ['Accessories', 'Accessories', 'Plugins', 'Databases'],
    note: 'Postgres, queues and other stateful services with stable names and volumes.',
  },
  {
    attribute: 'Multi-host',
    values: ['Fan-out', 'Yes', 'No', 'Yes'],
    note: 'bundant fans out to the hosts listed in deploy.yml; they are independent hosts, not a cluster.',
  },
  {
    attribute: 'Control',
    values: ['CLI only', 'CLI only', 'Git receiver', 'Web app'],
    note: 'bundant leaves nothing resident on the target host.',
  },
];
---

<section id="compare" class="border-b border-border py-16 md:py-24">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="mono-label">Compare</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
        Pick the deploy tool that matches the box.
      </h2>
      <p class="mt-4 text-muted-foreground">
        bundant is deliberately narrower than a platform. These are the attributes that
        decide whether it fits.
      </p>
    </div>

    <div class="mt-10 overflow-hidden rounded-xl border border-border bg-card">
      <table class="w-full border-collapse text-left text-[10px] sm:text-[13px]">
        <caption class="sr-only">Deployment tool comparison</caption>
        <thead>
          <tr class="border-b border-border">
            <th scope="col" class="px-1.5 py-3 font-medium uppercase tracking-wider text-muted-foreground sm:px-4">Attribute</th>
            {columns.map((column) => (
              <th
                scope="col"
                class:list={[
                  'px-1.5 py-3 text-[10px] font-semibold sm:px-4 sm:text-[11px]',
                  column === 'bundant' ? 'bg-primary/10 text-primary' : 'text-muted-foreground',
                ]}
              >
                {column}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-b border-border last:border-b-0">
              <th scope="row" class="px-1.5 py-3 align-top font-medium sm:px-4">{row.attribute}</th>
              {row.values.map((value, index) => (
                <td
                  class:list={[
                    'px-1.5 py-3 align-top sm:px-4',
                    index === 0 ? 'bg-primary/10 font-medium text-foreground' : 'text-muted-foreground',
                  ]}
                >
                  {value}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-4 max-w-3xl text-xs leading-relaxed text-muted-foreground">
      Values reflect each project's documented default workflow. "Optional" means a registry
      is not required: bundant can stream a locally built image over the same ssh connection.
      Check each project's docs for your setup.
    </p>
  </div>
</section>
