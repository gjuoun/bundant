{
  "name": "bundant",
  "version": "0.1.0",
  "description": "Zero-downtime single-host deploys over SSH — docker/podman + kamal-proxy + a thin Bun control plane. No Kubernetes.",
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "bundant": "bin/bundant",
    "bundant-bun": "bin/bundant-bun"
  },
  "license": "MIT",
  "author": "Jun Guo",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/gjuoun/bundant.git"
  },
  "homepage": "https://github.com/gjuoun/bundant#readme",
  "bugs": {
    "url": "https://github.com/gjuoun/bundant/issues"
  },
  "keywords": [
    "deploy",
    "deployment",
    "zero-downtime",
    "docker",
    "podman",
    "ssh",
    "kamal",
    "bun",
    "tailscale",
    "self-hosted"
  ],
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=22.6.0"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "start:node": "node src/cli.ts",
    "build": "bun build src/cli.ts --target=node --outfile=dist/cli.mjs --external zod --external yaml",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "schema:gen": "bun run scripts/gen-schema.ts",
    "api:gen": "bun run scripts/api-gen.ts",
    "api:check": "bun run scripts/api-gen.ts --check",
    "schema:check": "bun test src/schema.test.ts"
  },
  "dependencies": {
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "ajv": "^8.17.1",
    "openapi-typescript": "^7.13.0",
    "swagger2openapi": "^7.0.8",
    "typescript": "^5.7.0",
    "zod-to-json-schema": "^3.25.0"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
